#!/bin/bash
set -e

# Ensure data directory exists
mkdir -p /var/lib/proxai
chown proxai:proxai /var/lib/proxai
chmod 750 /var/lib/proxai

# Config directory
mkdir -p /etc/proxai

# Copy config from example only on first install
if [ ! -f /etc/proxai/config.toml ]; then
    cp /usr/share/doc/proxai/config.example.toml /etc/proxai/config.toml
fi
chmod 640 /etc/proxai/config.toml
chown root:proxai /etc/proxai/config.toml

# Reload systemd
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi

# Show instructions only on first install (not upgrade)
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    echo
    echo "=== ProxAI installed ==="
    echo
    echo "1. Edit /etc/proxai/config.toml and add your provider API keys."
    echo "2. Generate an API key for clients:"
    echo "     sudo -u proxai proxai key --key /var/lib/proxai/keys.db generate <name>"
    echo "   or start the server and use the admin socket:"
    echo "     sudo systemctl start proxai"
    echo "     proxai cli --socket /var/run/proxai/admin.sock generate-key <name>"
    echo "3. Enable the service to start on boot:"
    echo "     sudo systemctl enable proxai"
    echo
fi

exit 0
